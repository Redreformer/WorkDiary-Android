# Gradle properties template
# Copy this file to gradle.properties and fill in your signing credentials

android.useAndroidX=true
kotlin.code.style=official
org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
android.uniquePackageNames=false
android.dependency.useConstraints=true
android.r8.strictFullModeForKeepRules=false
android.builtInKotlin=false
android.newDsl=false

# Signing credentials for release builds
# Store these securely — never commit the real gradle.properties to version control
WORKDIARY_STORE_PASSWORD=your_store_password_here
WORKDIARY_KEY_PASSWORD=your_key_password_here